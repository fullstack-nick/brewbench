{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description"
        },
        "bb_fit": {
          "type": "bb_compatibility",
          "settings": {}
        },
        "bb_specs": {
          "type": "bb_specifications",
          "settings": {}
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "bb_fit",
        "description",
        "bb_specs"
      ],
      "settings": {
        "enable_sticky_info": false,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 40,
        "padding_bottom": 48
      }
    },
    "guide": {
      "type": "bb-guide",
      "settings": {}
    },
    "faq": {
      "type": "bb-faq",
      "blocks": {
        "fit": {
          "type": "question",
          "settings": {}
        },
        "demo": {
          "type": "question",
          "settings": {
            "question": "Is this a real shop?",
            "answer": "<p>Brewbench is a fictional practice project. Checkout uses a test gateway and no goods are shipped.</p>",
            "question_de": "Ist das ein echter Shop?",
            "answer_de": "<p>Brewbench ist ein fiktives Übungsprojekt. Der Checkout nutzt ein Test-Zahlungsgateway; es werden keine Waren versandt.</p>"
          }
        },
        "currency": {
          "type": "question",
          "settings": {
            "question": "Can I browse in German?",
            "answer": "<p>Yes. English and German are available. Choose Austria, Germany or the United Kingdom for delivery. All prices and test payments remain in EUR.</p>",
            "question_de": "Kann ich auf Deutsch stöbern?",
            "answer_de": "<p>Ja. Deutsch und Englisch sind verfügbar. Wähle Österreich, Deutschland oder das Vereinigte Königreich als Lieferland. Alle Preise und Testzahlungen bleiben in EUR.</p>"
          }
        }
      },
      "block_order": [
        "fit",
        "demo",
        "currency"
      ],
      "settings": {}
    }
  },
  "order": [
    "main",
    "guide",
    "faq"
  ]
}
