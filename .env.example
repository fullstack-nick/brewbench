# Examples only. Scripts read environment variables; no dotenv package is used.
SHOPIFY_STORE=brewbench-practice.myshopify.com
SHOPIFY_BASE_URL=https://brewbench-practice.myshopify.com
# Set the candidate theme ID in your shell; never commit the private resource ledger.
SHOPIFY_THEME_ID=
SHOPIFY_PASSWORD_FILE=.local/preflight/storefront-password.txt
# On non-Windows hosts, set the absolute path to @shopify/cli/bin/run.js.
SHOPIFY_CLI_ENTRY=
